Algoritmo ejercicio_13
	Definir ven, totalsem Como Real
	Definir a Como Entero
	a=1
	totalsem=0
	Mientras a <= 7 Hacer
		Escribir "Ingrese la venta del día: ", a 
		Leer ven
		
	totalsem= totalsem + ven
	a=a+1
	FinMientras
	
	Escribir "El total de la semana es de: $ ", totalsem
FinAlgoritmo
